{
  "extends": ["@electron-toolkit/tsconfig/tsconfig.node.json", "./tsconfig.strict.json"],
  "include": ["scripts/**/*"],
  "exclude": ["tests/fixtures/**", "tests/golden/__golden__/**", "e2e/__screenshots__/**"],
  "compilerOptions": {
    "composite": true,
    "allowJs": true,
    "checkJs": true,
    "strict": false,
    "noImplicitAny": false,
    "exactOptionalPropertyTypes": false,
    "noPropertyAccessFromIndexSignature": false,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2024",
    "types": ["node"]
  }
}
