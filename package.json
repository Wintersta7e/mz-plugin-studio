{
  "name": "mz-plugin-studio",
  "version": "1.8.1",
  "description": "Visual plugin builder for RPG Maker MZ",
  "main": "./out/main/index.js",
  "author": "MZ Plugin Studio",
  "license": "MIT",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "format": "node node_modules/prettier/bin/prettier.cjs --write .",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --check .",
    "lint": "node node_modules/eslint/bin/eslint.js --max-warnings 0 .",
    "typecheck:node": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:test": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.test.json --composite false",
    "typecheck:tools": "node node_modules/typescript/bin/tsc --noEmit -p tools/tsconfig.json --composite false",
    "typecheck:scripts": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.scripts.json --composite false",
    "typecheck:e2e": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.e2e.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:test && npm run typecheck:tools && npm run typecheck:scripts && npm run typecheck:e2e",
    "typecov:node": "node node_modules/type-coverage/bin/type-coverage -p tsconfig.node.json --strict --ignore-as-assertion --ignore-type-assertion --ignore-non-null-assertion",
    "typecov:web": "node node_modules/type-coverage/bin/type-coverage -p tsconfig.web.json --strict --ignore-as-assertion --ignore-type-assertion --ignore-non-null-assertion",
    "typecov:test": "node node_modules/type-coverage/bin/type-coverage -p tsconfig.test.json --strict --ignore-as-assertion --ignore-type-assertion --ignore-non-null-assertion",
    "typecov:tools": "cd tools && node ../node_modules/type-coverage/bin/type-coverage -p tsconfig.json --strict --ignore-as-assertion --ignore-type-assertion --ignore-non-null-assertion",
    "typecov:scripts": "node node_modules/type-coverage/bin/type-coverage -p tsconfig.scripts.json --strict --ignore-as-assertion --ignore-type-assertion --ignore-non-null-assertion",
    "typecov:e2e": "node node_modules/type-coverage/bin/type-coverage -p tsconfig.e2e.json --strict --ignore-as-assertion --ignore-type-assertion --ignore-non-null-assertion",
    "deps": "node node_modules/dependency-cruiser/bin/dependency-cruiser.mjs src tests tools scripts e2e --config .dependency-cruiser.mjs --ignore-known",
    "knip": "node node_modules/knip/bin/knip.js --treat-config-hints-as-errors",
    "knip:production": "node node_modules/knip/bin/knip.js --production --treat-config-hints-as-errors --max-issues 120 --reporter symbols --reporter ./scripts/knip-scanned.mjs",
    "strictness:status": "node scripts/strictness-status.mjs",
    "typecov:report": "node scripts/strictness-status.mjs --report typecov --node 55 --web 17 --test 319 --tools 0 --scripts 0 --e2e 4",
    "knip:report": "node scripts/strictness-status.mjs --report knip",
    "jscpd": "node node_modules/jscpd/run-jscpd.js",
    "jscpd:report": "node scripts/strictness-status.mjs --report jscpd --clones 110 --duplicated-lines 1288",
    "start": "node node_modules/electron-vite/bin/electron-vite.js preview",
    "dev": "node node_modules/electron-vite/bin/electron-vite.js dev",
    "build": "npm run typecheck && node node_modules/electron-vite/bin/electron-vite.js build",
    "build:unpack": "npm run build && node node_modules/electron-builder/cli.js --dir",
    "package:win": "node node_modules/electron-builder/cli.js --win --publish never",
    "build:win": "npm run build && npm run package:win",
    "ci:runtime-deps": "node scripts/ci-policy.mjs runtime-deps",
    "ci:toolchain": "node scripts/ci-policy.mjs toolchain",
    "e2e:prepare": "node scripts/e2e-prepare.mjs",
    "e2e": "node node_modules/@playwright/test/cli.js test -c e2e/playwright.config.ts --project=flows --project=release-smoke",
    "e2e:visual": "node node_modules/@playwright/test/cli.js test -c e2e/playwright.config.ts --project=visual",
    "e2e:visual:update": "node scripts/e2e-visual-update.mjs",
    "check": "npm run ci:runtime-deps && npm run lint && npm run typecheck && npm run typecov:report && npm run deps && npm run knip:report && npm run jscpd:report && npm run format:check && npm run strictness:status && npm run licenses -- --check && npm run test:coverage && npm run test:golden:coverage",
    "check:commits": "node scripts/check-golden-commits.mjs origin/main..HEAD",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "test:coverage": "node node_modules/vitest/vitest.mjs run --coverage && node scripts/check-coverage.mjs suite",
    "test:golden": "node node_modules/vitest/vitest.mjs run --project golden",
    "test:parity": "node node_modules/vitest/vitest.mjs run --project node tests/integration/mz-parity.test.ts",
    "test:golden:coverage": "node node_modules/vitest/vitest.mjs run --project golden --coverage --coverage.reportsDirectory=coverage/golden && node scripts/check-coverage.mjs golden",
    "licenses": "node scripts/third-party-licenses.mjs",
    "postinstall": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "electron-log": "^5.4.4"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/fuses": "2.1.3",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint-react/eslint-plugin": "5.28.8",
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "@monaco-editor/react": "^4.7.0",
    "@playwright/test": "1.64.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "~10.4.1",
    "@testing-library/jest-dom": "~7.0.1",
    "@testing-library/react": "~16.3.2",
    "@testing-library/user-event": "~14.6.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "@vitest/eslint-plugin": "1.6.28",
    "acorn": "^8.19.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "dependency-cruiser": "18.7.2",
    "dompurify": "^3.4.17",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.1",
    "electron-vite": "^6.0.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jest-dom": "5.10.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-playwright": "2.12.2",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-regexp": "3.3.3",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-testing-library": "7.16.2",
    "eslint-plugin-unicorn": "79.0.0",
    "framer-motion": "^14.9.0",
    "globals": "17.14.0",
    "jscpd": "5.4.2",
    "jsdom": "~30.1.2",
    "knip": "6.44.1",
    "lucide-react": "^1.66.0",
    "monaco-editor": "^0.57.0",
    "prettier": "3.8.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "type-coverage": "2.31.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "^8.3.5",
    "vitest": "5.0.3",
    "zustand": "^5.0.16"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "$dompurify"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
