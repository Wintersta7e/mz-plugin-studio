{
  "name": "mz-plugin-studio",
  "version": "1.6.1",
  "description": "Visual plugin builder for RPG Maker MZ",
  "main": "./out/main/index.js",
  "author": "MZ Plugin Studio",
  "license": "MIT",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "format": "node node_modules/prettier/bin/prettier.cjs --write .",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --check src/ tests/ scripts/ tools/ .github/ \"*.ts\" \"*.mjs\" \"*.js\" \"*.json\" \"*.yml\"",
    "lint": "node node_modules/eslint/bin/eslint.js src/ tests/",
    "lint:scripts": "node node_modules/eslint/bin/eslint.js --max-warnings 0 scripts/",
    "typecheck:node": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:test": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.test.json --composite false",
    "typecheck:scripts": "node node_modules/typescript/bin/tsc -p tsconfig.scripts.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:test && npm run typecheck:scripts",
    "start": "node node_modules/electron-vite/bin/electron-vite.js preview",
    "dev": "node node_modules/electron-vite/bin/electron-vite.js dev",
    "build": "npm run typecheck && node node_modules/electron-vite/bin/electron-vite.js build",
    "build:unpack": "npm run build && node node_modules/electron-builder/cli.js --dir",
    "package:win": "node node_modules/electron-builder/cli.js --win --publish never",
    "build:win": "npm run build && npm run package:win",
    "ci:runtime-deps": "node scripts/ci-policy.mjs runtime-deps",
    "ci:toolchain": "node scripts/ci-policy.mjs toolchain",
    "check": "npm run ci:runtime-deps && npm run lint && npm run lint:scripts && npm run format:check && npm run typecheck && npm run licenses -- --check && npm run test:coverage && npm run test:golden && npm run test:golden:coverage",
    "check:commits": "node scripts/check-golden-commits.mjs origin/main..HEAD",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "test:coverage": "node node_modules/vitest/vitest.mjs run --coverage && node scripts/check-coverage.mjs suite",
    "test:golden": "node node_modules/vitest/vitest.mjs run --project golden",
    "test:golden:coverage": "node node_modules/vitest/vitest.mjs run --project golden --coverage --coverage.reportsDirectory=coverage/golden && node scripts/check-coverage.mjs golden",
    "licenses": "node scripts/third-party-licenses.mjs"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "electron-log": "^5.4.3"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@monaco-editor/react": "^4.6.0",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.2",
    "@testing-library/dom": "~10.4.1",
    "@testing-library/jest-dom": "~7.0.1",
    "@testing-library/react": "~16.3.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "5.0.3",
    "acorn": "^8.19.0",
    "autoprefixer": "^10.5.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "electron": "^41.10.7",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.34.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "framer-motion": "^12.38.0",
    "jsdom": "~30.1.2",
    "lucide-react": "^1.8.0",
    "postcss": "^8.5.10",
    "prettier": "^3.8.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.3",
    "vite": "^7.3.1",
    "vitest": "5.0.3",
    "zustand": "^5.0.12"
  }
}
