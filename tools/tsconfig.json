{
  "extends": "../tsconfig.strict.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "composite": true,
    "types": ["node"],
    "outDir": "./dist",
    "rootDir": ".",
    "sourceMap": false,
    "noUncheckedIndexedAccess": false
  },
  "include": ["./*.ts"],
  "exclude": [
    "dist",
    "output",
    "../tests/fixtures/**",
    "../tests/golden/__golden__/**",
    "../e2e/__screenshots__/**"
  ]
}
