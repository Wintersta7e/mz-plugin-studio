{
  "extends": ["@electron-toolkit/tsconfig/tsconfig.node.json", "./tsconfig.strict.json"],
  "include": ["e2e/**/*"],
  "exclude": ["tests/fixtures/**", "tests/golden/__golden__/**", "e2e/__screenshots__/**"],
  "compilerOptions": {
    "composite": true,
    "types": ["node"],
    "allowJs": true,
    "exactOptionalPropertyTypes": false,
    "noPropertyAccessFromIndexSignature": false,
    "noUncheckedIndexedAccess": false
  }
}
