{
  "extends": ["@electron-toolkit/tsconfig/tsconfig.node.json", "./tsconfig.strict.json"],
  "include": [
    "tests/**/*",
    "src/main/**/*",
    "src/renderer/src/**/*",
    "src/shared/**/*",
    "src/preload/**/*",
    "lint-scope.json"
  ],
  "exclude": ["tests/fixtures/**", "tests/golden/__golden__/**", "e2e/__screenshots__/**"],
  "compilerOptions": {
    "composite": true,
    "types": ["node", "vitest/globals"],
    "jsx": "react-jsx",
    "allowJs": true,
    "exactOptionalPropertyTypes": false,
    "noPropertyAccessFromIndexSignature": false,
    "noUncheckedIndexedAccess": false,
    "paths": {
      "@renderer/*": ["./src/renderer/src/*"],
      "@/*": ["./src/renderer/src/*"]
    }
  }
}
