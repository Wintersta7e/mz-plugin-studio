{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": ["tests/**/*", "src/main/**/*", "src/renderer/src/**/*", "src/shared/**/*"],
  "exclude": ["tests/fixtures/**", "tests/golden/__golden__/**"],
  "compilerOptions": {
    "composite": true,
    "types": ["node", "vitest/globals"],
    "jsx": "react-jsx",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "@renderer/*": ["./src/renderer/src/*"],
      "@/*": ["./src/renderer/src/*"]
    }
  }
}
