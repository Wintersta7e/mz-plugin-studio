{
  "dataGlobs": ["tests/fixtures/**", "tests/golden/__golden__/**", "e2e/__screenshots__/**"],
  "jsAllowlist": ["eslint.config.mjs", ".dependency-cruiser.mjs"],
  "presets": [
    {
      "id": "@eslint/js recommended",
      "files": ["**/*.{ts,tsx,mts,cts,js,mjs,cjs}"]
    },
    {
      "id": "typescript-eslint strictTypeChecked",
      "files": ["**/*.{ts,tsx,mts,cts}"]
    },
    {
      "id": "typescript-eslint stylisticTypeChecked",
      "files": ["**/*.{ts,tsx,mts,cts}"]
    },
    {
      "id": "@eslint-react/eslint-plugin strict-type-checked",
      "files": ["src/renderer/**/*.{ts,tsx}", "tests/**/*.tsx"]
    },
    {
      "id": "eslint-plugin-react-hooks recommended-latest",
      "files": ["src/renderer/**/*.{ts,tsx}", "tests/**/*.tsx"]
    },
    {
      "id": "eslint-plugin-jsx-a11y strict",
      "files": ["src/renderer/**/*.tsx", "tests/**/*.tsx"]
    },
    {
      "id": "eslint-plugin-no-unsanitized recommended",
      "files": ["src/renderer/**"]
    },
    {
      "id": "eslint-plugin-unicorn recommended",
      "files": ["**/*.{ts,tsx,mts,cts,js,mjs,cjs}"]
    },
    {
      "id": "eslint-plugin-sonarjs recommended",
      "files": ["**/*.{ts,tsx,mts,cts,js,mjs,cjs}"]
    },
    {
      "id": "eslint-plugin-regexp flat/recommended",
      "files": ["**/*.{ts,tsx,mts,cts,js,mjs,cjs}"]
    },
    {
      "id": "eslint-plugin-promise flat/recommended",
      "files": ["**/*.{ts,tsx,mts,cts,js,mjs,cjs}"]
    },
    {
      "id": "eslint-plugin-import-x flatConfigs.recommended",
      "files": ["**/*.{ts,tsx,mts,cts,js,mjs,cjs}"]
    },
    {
      "id": "eslint-plugin-import-x flatConfigs.typescript",
      "files": ["**/*.{ts,tsx,mts,cts,js,mjs,cjs}"]
    },
    {
      "id": "eslint-plugin-n flat/recommended-module",
      "files": ["src/main/**", "tools/**", "scripts/**", "*.{ts,mts,cts,js,mjs,cjs}"]
    },
    {
      "id": "@eslint-community/eslint-plugin-eslint-comments recommended",
      "files": ["**/*.{ts,tsx,mts,cts,js,mjs,cjs}"]
    },
    {
      "id": "@vitest/eslint-plugin all",
      "files": ["tests/**"]
    },
    {
      "id": "eslint-plugin-testing-library flat/react",
      "files": ["tests/**/*.tsx"]
    },
    {
      "id": "eslint-plugin-jest-dom flat/recommended",
      "files": ["tests/**"]
    },
    {
      "id": "eslint-plugin-playwright flat/recommended",
      "files": ["e2e/**"]
    },
    {
      "id": "typescript-eslint disableTypeChecked",
      "files": ["**/*.{js,mjs,cjs}"]
    }
  ],
  "optIns": [
    {
      "files": ["**/*.{ts,tsx,mts,cts,js,mjs,cjs}"],
      "rules": {
        "eqeqeq": "error",
        "complexity": ["error", 15],
        "max-lines-per-function": [
          "error",
          { "max": 80, "skipBlankLines": true, "skipComments": true, "IIFEs": true }
        ],
        "no-duplicate-imports": "error",
        "no-console": [
          "error",
          {
            "allow": ["warn", "error"]
          }
        ],
        "no-alert": "error",
        "@eslint-community/eslint-comments/require-description": "error",
        "@eslint-community/eslint-comments/no-use": [
          "error",
          {
            "allow": ["eslint-disable-next-line"]
          }
        ]
      }
    },
    {
      "files": ["**/*.{ts,tsx,mts,cts}"],
      "rules": {
        "@typescript-eslint/switch-exhaustiveness-check": [
          "error",
          {
            "considerDefaultExhaustiveForUnions": false,
            "requireDefaultForNonUnion": true
          }
        ],
        "@typescript-eslint/strict-boolean-expressions": "error",
        "@typescript-eslint/no-unsafe-type-assertion": "error",
        "@typescript-eslint/require-array-sort-compare": "error",
        "@typescript-eslint/promise-function-async": "error",
        "@typescript-eslint/consistent-type-exports": "error",
        "@typescript-eslint/no-import-type-side-effects": "error",
        "@typescript-eslint/consistent-type-imports": [
          "error",
          {
            "prefer": "type-imports",
            "fixStyle": "inline-type-imports"
          }
        ],
        "@typescript-eslint/ban-ts-comment": [
          "error",
          {
            "ts-expect-error": true,
            "ts-ignore": true,
            "ts-nocheck": true
          }
        ]
      }
    },
    {
      "files": ["tests/**"],
      "rules": {
        "vitest/prefer-strict-equal": "error",
        "vitest/require-mock-type-parameters": "error",
        "vitest/prefer-import-in-mock": "error",
        "vitest/prefer-expect-assertions": [
          "error",
          {
            "onlyFunctionsWithAsyncKeyword": true
          }
        ],
        "vitest/no-conditional-in-test": "error",
        "vitest/prefer-to-have-length": "error",
        "vitest/prefer-to-contain": "error",
        "vitest/prefer-strict-boolean-matchers": "error",
        "vitest/prefer-spy-on": "error",
        "vitest/prefer-vi-mocked": "error",
        "vitest/valid-title": [
          "error",
          {
            "allowArguments": true
          }
        ]
      }
    }
  ],
  "exclusions": [
    {
      "rule": "unicorn/prefer-single-call",
      "files": [
        "src/renderer/src/lib/generator/index.ts",
        "src/renderer/src/lib/generator/templates/**"
      ],
      "ignores": [
        "src/renderer/src/lib/generator/templates/actor-party.ts",
        "src/renderer/src/lib/generator/templates/database-extension.ts",
        "src/renderer/src/lib/generator/templates/index.ts",
        "src/renderer/src/lib/generator/templates/map-events.ts",
        "src/renderer/src/lib/generator/templates/message-system.ts",
        "src/renderer/src/lib/generator/templates/save-load.ts",
        "src/renderer/src/lib/generator/templates/scene-hooks.ts",
        "src/renderer/src/lib/generator/templates/sprite-system.ts",
        "src/renderer/src/lib/generator/templates/types.ts",
        "src/renderer/src/lib/generator/templates/values.ts"
      ],
      "code": "S",
      "reason": "One lines.push per emitted line is the contract of the generator and of the templates that build output line by line (docs/CONTRIBUTING_TEMPLATES.md)"
    },
    {
      "rule": "unicorn/name-replacements",
      "files": ["**/*.{ts,tsx,mts,cts,js,mjs,cjs}"],
      "code": "S",
      "reason": "props and ref are React API names, param and arg (and their plurals) MZ annotation names; every other abbreviation is renamed",
      "options": [
        {
          "replacements": {
            "arg": false,
            "args": false,
            "param": false,
            "params": false,
            "props": false,
            "ref": false
          }
        }
      ]
    },
    {
      "rule": "@typescript-eslint/restrict-template-expressions",
      "files": [
        "src/renderer/src/lib/generator/templates/custom-window.ts",
        "src/renderer/src/lib/generator/templates/input-handler.ts",
        "src/renderer/src/lib/generator/templates/menu-system.ts",
        "src/renderer/src/lib/generator/templates/message-system.ts",
        "src/renderer/src/lib/generator/templates/plugin-commands.ts",
        "src/renderer/src/lib/generator/templates/sprite-system.ts"
      ],
      "code": "S",
      "reason": "These templates emit numbers into plugin text; everywhere else a number is converted explicitly",
      "options": [
        {
          "allowAny": false,
          "allowArray": false,
          "allowBoolean": false,
          "allowNever": false,
          "allowNullish": false,
          "allowNumber": true,
          "allowRegExp": false
        }
      ]
    },
    {
      "rule": "unicorn/no-null",
      "files": [
