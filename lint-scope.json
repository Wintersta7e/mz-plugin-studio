        "tests/unit/injection.test.ts",
        "tests/unit/package-scripts.test.ts",
        "tests/unit/param-io.test.ts",
        "tests/unit/plugin-output.test.ts",
        "tests/unit/round-trip.test.ts"
      ],
      "code": "S",
      "reason": "These files build or read the null-bearing persisted, IPC and React-state shapes; converting persisted null would drop keys"
    },
    {
      "rule": "no-console",
      "files": ["tools/**"],
      "code": "S",
      "reason": "The command-line tools print by design"
    },
    {
      "rule": "sonarjs/prefer-regexp-exec",
      "files": ["**/*.{ts,tsx,mts,cts,js,mjs,cjs}"],
      "code": "D",
      "reason": "@typescript-eslint/prefer-regexp-exec owns the same check"
    },
    {
      "rule": "sonarjs/super-linear-regex",
      "files": ["**/*.{ts,tsx,mts,cts,js,mjs,cjs}"],
      "code": "D",
      "reason": "regexp/no-super-linear-backtracking owns the same check"
    },
    {
      "rule": "n/no-unpublished-import",
      "files": ["src/main/**", "tools/**", "scripts/**", "*.{ts,mts,cts,js,mjs,cjs}"],
      "ignores": [
        "electron.vite.config.ts",
        "eslint.config.mjs",
        "scripts/e2e-prepare.mjs",
        "vitest.config.ts"
      ],
      "code": "S",
      "reason": "Electron is provided by the runtime; every other import must be a published dependency",
      "options": [
        {
          "allowModules": ["electron"]
        }
      ]
    },
    {
      "rule": "n/no-unpublished-import",
      "files": [
        "electron.vite.config.ts",
        "eslint.config.mjs",
        "scripts/e2e-prepare.mjs",
        "vitest.config.ts"
      ],
      "code": "S",
      "reason": "The build, lint and test configs and the e2e build script run from the development install"
    },
    {
      "rule": "sonarjs/deprecation",
      "files": ["**/*.{ts,tsx,mts,cts,js,mjs,cjs}"],
      "code": "D",
      "reason": "@typescript-eslint/no-deprecated owns the same check"
    },
    {
      "rule": "sonarjs/concise-regex",
      "files": ["**/*.{ts,tsx,mts,cts,js,mjs,cjs}"],
      "code": "D",
      "reason": "regexp/prefer-d, prefer-w and prefer-character-class own the same check"
    },
    {
      "rule": "unicorn/filename-case",
      "files": ["src/renderer/src/App.tsx", "src/renderer/src/components/**/*.tsx"],
      "ignores": ["src/renderer/src/components/ui/**"],
      "code": "S",
      "reason": "React component files are PascalCase; kebab-case stays on everywhere else",
      "options": [
        {
          "case": "pascalCase",
          "checkDirectories": false
        }
      ]
    },
    {
      "rule": "n/no-missing-import",
      "files": ["src/main/**", "tools/**", "scripts/**", "*.{ts,mts,cts,js,mjs,cjs}"],
      "code": "X/D",
      "reason": "Extensionless imports resolve to .ts files under bundler resolution; the resolver tries .ts as TypeScript does",
      "options": [
        {
          "tryExtensions": [".js", ".json", ".node", ".ts"]
        }
      ]
    },
    {
      "rule": "unicorn/no-process-exit",
      "files": ["**/*.{ts,tsx,mts,cts,js,mjs,cjs}"],
      "code": "D",
      "reason": "n/no-process-exit owns the same check"
    },
    {
      "rule": "sonarjs/no-unused-vars",
      "files": ["**/*.{ts,tsx,mts,cts,js,mjs,cjs}"],
      "code": "D",
      "reason": "@typescript-eslint/no-unused-vars owns the same check"
    },
    {
      "rule": "sonarjs/no-redundant-assignments",
      "files": ["**/*.{ts,tsx,mts,cts,js,mjs,cjs}"],
      "code": "D",
      "reason": "Core no-useless-assignment owns the same check"
    },
    {
      "rule": "sonarjs/no-alphabetical-sort",
      "files": ["**/*.{ts,tsx,mts,cts,js,mjs,cjs}"],
      "code": "D",
      "reason": "@typescript-eslint/require-array-sort-compare owns the same check"
    },
    {
      "rule": "import-x/no-unresolved",
      "files": ["**/*.{ts,tsx,mts,cts,js,mjs,cjs}"],
      "code": "D",
      "reason": "The type-check of each program owns module resolution"
    },
    {
      "rule": "import-x/named",
      "files": ["**/*.{ts,tsx,mts,cts,js,mjs,cjs}"],
      "code": "D",
      "reason": "The type-check of each program owns named-export checks"
    },
    {
      "rule": "import-x/namespace",
      "files": ["**/*.{ts,tsx,mts,cts,js,mjs,cjs}"],
      "code": "D",
      "reason": "The type-check of each program owns namespace member checks"
    },
    {
      "rule": "import-x/default",
      "files": ["**/*.{ts,tsx,mts,cts,js,mjs,cjs}"],
      "code": "D",
      "reason": "The type-check of each program owns default-export checks"
    },
