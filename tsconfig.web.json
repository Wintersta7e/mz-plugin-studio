{
  "extends": ["@electron-toolkit/tsconfig/tsconfig.web.json", "./tsconfig.strict.json"],
  "include": [
    "src/renderer/src/environment.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/shared/**/*"
  ],
  "exclude": [
    "src/shared/path-safety.ts",
    "tests/fixtures/**",
    "tests/golden/__golden__/**",
    "e2e/__screenshots__/**"
  ],
  "compilerOptions": {
    "composite": true,
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false,
    "paths": {
      "@renderer/*": ["./src/renderer/src/*"],
      "@/*": ["./src/renderer/src/*"],
      "monaco-editor/esm/vs/editor/editor.api": [
        "./node_modules/monaco-editor/esm/vs/editor/editor.api.d.ts"
      ]
    }
  }
}
